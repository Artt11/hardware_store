# Suro Hardware Store - environment template. Copy to `.env` and fill in real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Required: development | test | production (production enforces strong secrets,
# Secure/__Host- cookies, https-only CORS and disables /docs)
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=suro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hardware_store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT secrets: two different strong random values (required in production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Storefront origin(s) allowed to call the API with credentials (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Reverse proxies allowed to set X-Forwarded-For (JSON list); empty when none
TRUSTED_PROXY_IPS=[]

# Seeding (python -m app.seed.run)
SEED_DEFAULT_STOCK=100
# SEED_DEMO_PASSWORD=   # >= 12 chars; needed for --demo-users (never in production)
