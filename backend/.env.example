# ============================================================================
# B2C / B2B Hardware E-Commerce Platform — Environment Configuration Template
# Copy this file to `.env` and replace placeholder secrets before deployment.
# ============================================================================

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=hardware_store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Elasticsearch Service
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=hardware_products

# Redis Session & Cache Store
REDIS_URL=redis://localhost:6379/0

# Application & JWT Security Secrets (generate via: openssl rand -hex 32)
SECRET_KEY=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32
JWT_SECRET=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_distinct_64_char_hex_refresh_secret_key
ENVIRONMENT=development

